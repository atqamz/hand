{
  "contract": 1,
  "note": "Normative test vectors for the Companion contract in docs/companion.md. A copy of this file is checked by the app's own tests. Entries are only ever added within a contract version.",
  "wire": {
    "alpn": "hand-board",
    "streams_per_connection": 12,
    "streams_per_second": 20,
    "uni_streams": 0,
    "close_codes": {
      "full": 1,
      "idle": 2
    },
    "stream_codes": {
      "board_unreachable": 3,
      "stream_idle": 4,
      "board_error": 5
    },
    "max_connections_default": 16,
    "idle_seconds_default": 60,
    "handshakes_in_flight": 8,
    "handshake_seconds": 3,
    "connections_per_source": 4,
    "preface": "HAND-PEER 1 <endpoint id> <secret>\n"
  },
  "board": {
    "code_alphabet": "0123456789ABCDEFGHJKMNPQRSTVWXYZ",
    "code_length": 10,
    "code_seconds": 300,
    "wrong_tries_per_peer_per_minute": 5,
    "wrong_tries_before_all_codes_cancel": 10,
    "phone_days": 90,
    "unpaired_requests_per_connection": 32,
    "unpaired_bytes_per_connection": 65536,
    "unpaired_body_seconds": 10,
    "idle_connection_seconds": 30,
    "fleet_id": "^f[0-9a-f]{12}$",
    "device_login": "iroh:<endpoint id>"
  },
  "link": {
    "max_bytes": 213,
    "prefix": "handboard://c#",
    "reasons": [
      "too_long",
      "characters",
      "scheme",
      "no_fragment",
      "query",
      "target",
      "version_missing",
      "version_unsupported",
      "fragment",
      "duplicate_key",
      "missing_key",
      "endpoint_id",
      "fleet",
      "code",
      "relay"
    ]
  },
  "alerts": {
    "route": "GET /<fleet id>/alerts/feed?after=<seq>&wait=<seconds>",
    "wait_seconds_max": 25,
    "batch_max": 50,
    "window_hours": 24,
    "keep_days": 7,
    "text_max_runes": 200,
    "response_fields": [
      "version",
      "fleet",
      "cursor",
      "more",
      "alerts"
    ],
    "alert_fields": [
      "seq",
      "at",
      "kind",
      "ref",
      "text",
      "link"
    ],
    "kinds": [
      "decision.asked",
      "attempt.blocked",
      "attempt.quiet",
      "attempt.limited",
      "attempt.exited",
      "attempt.stopped",
      "attempt.failed",
      "attempt.interrupted",
      "attempt.long",
      "supervisor.blocked",
      "supervisor.limited",
      "supervisor.stalled"
    ],
    "exchanges": [
      {
        "name": "the first poll gets the cursor, never the history",
        "given": [
          {
            "kind": "decision.asked",
            "ref": "d3",
            "text": "t3 decision: Keep the old cookie name?",
            "link": "handboard://open/f0123456789ab/decision/d3"
          },
          {
            "kind": "attempt.blocked",
            "ref": "a7",
            "text": "a7 blocked: Do you want to proceed?",
            "link": "handboard://open/f0123456789ab/attempt/a7"
          },
          {
            "kind": "supervisor.stalled",
            "ref": "supervisor",
            "text": "s1 stalled: t1 is active, no attempt is running, idle 20m",
            "link": "handboard://open/f0123456789ab/"
          }
        ],
        "request": "?wait=25",
        "status": 200,
        "body": {
          "version": 1,
          "fleet": {
            "id": "f0123456789ab",
            "name": "hand"
          },
          "cursor": 3,
          "more": false,
          "alerts": []
        }
      },
      {
